DirectoryIndex index.php

RewriteEngine On

# Forcar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Clean URLs — paginas
RewriteRule ^login$ login.php [L]
RewriteRule ^register$ register.php [L]
RewriteRule ^dashboard$ dashboard.php [L]

# Clean URLs — auth handlers
RewriteRule ^auth/status$ auth/status.php [L]
RewriteRule ^auth/logout$ auth/logout.php [L]
RewriteRule ^auth/register$ auth/register.php [L]
RewriteRule ^auth/login$ auth/login.php [L]
RewriteRule ^auth/confirm$ auth/confirm.php [L]
RewriteRule ^auth/google$ auth/google.php [L]
RewriteRule ^auth/google/callback$ auth/google_callback.php [L]

# Paginas legais
RewriteRule ^terms$ terms.php [L]
RewriteRule ^privacy$ privacy.php [L]
RewriteRule ^admin$ admin.php [L]
RewriteRule ^admin/import$ admin/import.php [L]

# Quiz
RewriteRule ^quiz$ quiz/index.php [L]
RewriteRule ^quiz/take$ quiz/take.php [L]
RewriteRule ^quiz/answer$ quiz/answer.php [L]
RewriteRule ^quiz/result$ quiz/result.php [L]

# CSS, JS, assets — servir diretamente

# CSS, JS, assets — servir diretamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
