DirectoryIndex index.html

RewriteEngine On

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Rotas da API → proxy para Node.js (porta 3000)
# Apenas /auth/* precisa do Node.js; login, register, dashboard são servidos como estáticos
RewriteRule ^auth/(.*) http://localhost:3000/auth/$1 [P,L]
