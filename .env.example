# Servidor
PORT=3000
NODE_ENV=development

# URL base (alterar em produção)
BASE_URL=http://localhost:3000

# OAuth2 - Google
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id_google
