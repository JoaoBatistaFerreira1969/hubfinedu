# Servidor
PORT=3000
NODE_ENV=production
BASE_URL=https://hubfinedu.com.br

# OAuth2 - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=seu_client_id_google
GOOGLE_CLIENT_SECRET=seu_client_secret_google

# Sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=coloque_uma_string_aleatoria_aqui

# Email (SMTP) — use senha de app do Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
