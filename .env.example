# Servidor
PORT=3000
NODE_ENV=production
BASE_URL=https://hubfinedu.com.br

# OAuth2 - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=seu_client_id_google
GOOGLE_CLIENT_SECRET=seu_client_secret_google

# Sessao (gere com: openssl rand -hex 32)
SESSION_SECRET=coloque_uma_string_aleatoria_aqui

# Email (SMTP)
# Para Gmail: smtp.gmail.com, porta 587, secure=false, use senha de app
# Para Hostinger: smtp.hostinger.com, porta 587, secure=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@hubfinedu.com.br
SMTP_PASS=sua_senha_de_app
SMTP_FROM=noreply@hubfinedu.com.br

# reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=sua_chave_publica_do_recaptcha
RECAPTCHA_SECRET_KEY=sua_chave_secreta_do_recaptcha
